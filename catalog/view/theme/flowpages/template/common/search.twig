<div id="search" class="input-group" data-fp-autocomplete data-suggest-url="{{ suggest_url }}" data-search-url="{{ search_url }}" data-min-length="2" data-limit="8">
  <input type="search" name="search" value="{{ search }}" placeholder="{{ text_search }}" class="form-control input-lg" maxlength="500" autocomplete="off" />
  <span class="input-group-btn">
    <button type="button" class="btn btn-default btn-lg"><i class="fa fa-search"></i></button>
  </span>
</div>
