# Local OpenCart configuration and secrets
/config.php
/admin/config.php
/.env
/.env.*
!/.env.example

# Local backups, exports, temporary work and generated documents
/backups/
/data/**/backups/
/data/currency-backup-*/
/tmp/
/output/

# Local runtime data
/system/storage/cache/
/system/storage/download/
/system/storage/logs/
/system/storage/modification/
/system/storage/session/
/system/storage/upload/
/image/cache/
*.log
*.pid

# Python environments and generated bytecode
/ml_search/.venv/
/ml_search/.venv-training/
__pycache__/
*.py[cod]

# Locally downloaded or trained ML artifacts and private experiment material
/data/ml_search/local-model/
/data/ml_search/model-cache/
/data/ml_search/indexes/
